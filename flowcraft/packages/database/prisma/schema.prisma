generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String
  passwordHash         String
  organizationId       String?
  role                 UserRole           @default(USER)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  connectorConfigs     ConnectorConfig[]
  connectors           Connector[]
  executions           Execution[]
  approvedTranslations Translation[]
  organization         Organization?      @relation(fields: [organizationId], references: [id])
  workflowTemplates    WorkflowTemplate[]
  workflowVersions     WorkflowVersion[]
  workflows            Workflow[]

  @@map("users")
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  plan              Plan               @default(FREE)
  settings          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  connectors        Connector[]
  users             User[]
  workflowTemplates WorkflowTemplate[]
  workflows         Workflow[]

  @@map("organizations")
}

model Workflow {
  id             String            @id @default(cuid())
  name           String
  description    String?
  definition     Json
  userId         String
  organizationId String?
  status         WorkflowStatus    @default(DRAFT)
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  executions     Execution[]
  versions       WorkflowVersion[]
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@map("workflows")
}

model WorkflowVersion {
  id            String   @id @default(cuid())
  workflowId    String
  definition    Json
  createdAt     DateTime @default(now())
  changelog     String?
  createdBy     String
  versionNumber Int
  user          User     @relation(fields: [createdBy], references: [id])
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, versionNumber])
  @@map("workflow_versions")
}

model WorkflowTemplate {
  id             String        @id @default(cuid())
  name           String
  description    String?
  definition     Json
  category       String
  isPublic       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  createdBy      String
  organizationId String?
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [createdBy], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([category])
  @@index([isPublic])
  @@index([organizationId])
  @@map("workflow_templates")
}

model Execution {
  id              String          @id @default(cuid())
  workflowId      String
  status          ExecutionStatus
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  inputData       Json?
  outputData      Json?
  errorDetails    Json?
  executionTimeMs Int?
  userId          String
  dataFlow        Json?
  metadata        Json?
  summary         Json?
  logs            ExecutionLog[]
  nodes           ExecutionNode[]
  user            User            @relation(fields: [userId], references: [id])
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("executions")
}

model ExecutionNode {
  id              String          @id @default(cuid())
  executionId     String
  nodeId          String
  status          ExecutionStatus
  startedAt       DateTime?
  completedAt     DateTime?
  inputData       Json?
  outputData      Json?
  errorDetails    Json?
  dataSchema      Json?
  metadata        Json?
  performance     Json?
  transformations Json?
  execution       Execution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("execution_nodes")
}

model Connector {
  id             String                @id @default(cuid())
  name           String
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  configuration  Json
  createdBy      String
  description    String?
  organizationId String?
  type           String
  updatedAt      DateTime              @updatedAt
  version        Int                   @default(1)
  configs        ConnectorConfig[]
  credentials    ConnectorCredential[]
  logs           ConnectorLog[]
  user           User                  @relation(fields: [createdBy], references: [id])
  organization   Organization?         @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
  @@map("connectors")
}

model ConnectorCredential {
  id            String    @id @default(cuid())
  connectorId   String
  name          String
  type          String
  encryptedData String
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  connector     Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@map("connector_credentials")
}

model ConnectorLog {
  id          String    @id @default(cuid())
  connectorId String
  message     String
  metadata    Json?
  createdAt   DateTime  @default(now())
  level       String
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@map("connector_logs")
}

model ConnectorConfig {
  id          String    @id @default(cuid())
  connectorId String
  userId      String
  configData  Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("connector_configs")
}

model ExecutionLog {
  id          String    @id @default(cuid())
  executionId String
  level       LogLevel
  message     String
  metadata    Json?
  createdAt   DateTime  @default(now())
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("execution_logs")
}

model Metric {
  id        String   @id @default(cuid())
  name      String
  value     Float
  labels    Json?
  timestamp DateTime @default(now())

  @@map("metrics")
}

model Alert {
  id         String      @id @default(cuid())
  name       String
  condition  String
  status     AlertStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  @@map("alerts")
}

model Language {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  nativeName   String
  flagEmoji    String?
  isActive     Boolean       @default(true)
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]

  @@map("languages")
}

model TranslationKey {
  id           String        @id @default(cuid())
  key          String        @unique
  namespace    String
  category     String?
  description  String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]

  @@index([namespace])
  @@map("translation_keys")
}

model Translation {
  id         String         @id @default(cuid())
  languageId String
  keyId      String
  value      String
  isApproved Boolean        @default(false)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  approver   User?          @relation(fields: [approvedBy], references: [id])
  key        TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  language   Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([languageId, keyId])
  @@index([languageId, keyId])
  @@map("translations")
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum Plan {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  ACKNOWLEDGED
}
