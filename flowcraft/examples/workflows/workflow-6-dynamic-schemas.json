{
  "id": "workflow-6-dynamic-schemas",
  "name": "Dynamic Schemas Demo",
  "description": "Workflow para demostrar el sistema de esquemas dinámicos con transformaciones y diferentes tipos de nodos",
  "version": "1.0",
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z",
  "nodes": [
    {
      "id": "start-1",
      "type": "START",
      "position": { "x": 100, "y": 100 },
      "data": {
        "label": "Dynamic Start",
        "description": "Nodo inicial con datos dinámicos",
        "triggerType": "webhook",
        "webhookUrl": "https://api.example.com/webhook",
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
    {
      "id": "condition-1",
      "type": "CONDITION",
      "position": { "x": 400, "y": 100 },
      "data": {
        "label": "Dynamic Condition",
        "description": "Condición con esquemas dinámicos",
        "dataConditions": [
          {
            "id": "cond-1",
            "field": "webhookData.status",
            "operator": "equals",
            "value": "success",
            "enabled": true,
            "description": "Verificar si el webhook fue exitoso"
          },
          {
            "id": "cond-2",
            "field": "webhookData.count",
            "operator": "greater_than",
            "value": "5",
            "enabled": true,
            "description": "Verificar si hay suficientes elementos"
          }
        ],
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
    {
      "id": "http-request-1",
      "type": "HTTP_REQUEST",
      "position": { "x": 700, "y": 50 },
      "data": {
        "label": "Dynamic HTTP Request",
        "description": "HTTP Request con esquemas dinámicos",
        "actionConfig": {
          "url": "https://api.example.com/data",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer {{token}}"
          },
          "body": {
            "data": "{{trueBranch.webhookData}}",
            "timestamp": "{{trueBranch.timestamp}}"
          }
        },
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
    {
      "id": "data-transform-1",
      "type": "DATA_TRANSFORM",
      "position": { "x": 700, "y": 200 },
      "data": {
        "label": "Dynamic Data Transform",
        "description": "Transformación de datos con esquemas dinámicos",
        "transformConfig": {
          "fieldMappings": [
            {
              "sourceField": "falseBranch.webhookData",
              "targetField": "processedData",
              "required": true,
              "description": "Mapear datos de la rama falsa"
            }
          ],
          "transformations": [
            {
              "id": "trans-1",
              "type": "TRANSFORM",
              "config": {
                "transformType": "toUpperCase"
              },
              "description": "Convertir a mayúsculas",
              "order": 1,
              "enabled": true
            },
            {
              "id": "trans-2",
              "type": "FORMAT",
              "config": {
                "formatType": "date"
              },
              "description": "Formatear fecha",
              "order": 2,
              "enabled": true
            }
          ]
        },
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
    {
      "id": "email-1",
      "type": "EMAIL",
      "position": { "x": 1000, "y": 50 },
      "data": {
        "label": "Dynamic Email",
        "description": "Email con esquemas dinámicos",
        "actionConfig": {
          "to": "admin@example.com",
          "subject": "HTTP Request Result: {{responseStatus}}",
          "emailBody": "Response data: {{responseData}}",
          "attachments": []
        },
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
    {
      "id": "slack-1",
      "type": "SLACK",
      "position": { "x": 1000, "y": 200 },
      "data": {
        "label": "Dynamic Slack",
        "description": "Slack con esquemas dinámicos",
        "actionConfig": {
          "channel": "#alerts",
          "slackMessage": "Data processed: {{processedData}}",
          "blocks": []
        },
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
    {
      "id": "end-1",
      "type": "END",
      "position": { "x": 1300, "y": 125 },
      "data": {
        "label": "Dynamic End",
        "description": "Nodo final con esquemas dinámicos",
        "resultType": "success",
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    }
