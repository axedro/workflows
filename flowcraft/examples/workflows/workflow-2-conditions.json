{
  "id": "workflow-2-conditions",
  "name": "Workflow 2: Condiciones y Transformaciones",
  "description": "Workflow con nodo de condición (rombo) y transformaciones de datos",
  "version": "1.0",
  "createdAt": "2024-01-15T10:30:00Z",
  "updatedAt": "2024-01-15T10:30:00Z",
  "nodes": [
    {
      "id": "start-1",
      "type": "START",
      "position": { "x": 200, "y": 50 },
      "data": {
        "label": "Start",
        "description": "Nodo de inicio"
      }
    },
    {
      "id": "condition-1",
      "type": "CONDITION",
      "position": { "x": 200, "y": 200 },
      "data": {
        "label": "Check Status",
        "description": "Verificar estado de datos",
        "conditionConfig": {
          "conditions": [
            {
              "id": "cond-1",
              "field": "data.status",
              "operator": "equals",
              "value": "active",
              "description": "Verificar si el estado es activo"
            },
            {
              "id": "cond-2",
              "field": "data.count",
              "operator": "greater_than",
              "value": "10",
              "description": "Verificar si el conteo es mayor a 10"
            }
          ],
          "logic": "AND"
        }
      }
    },
    {
      "id": "action-true",
      "type": "ACTION",
      "position": { "x": 400, "y": 150 },
      "data": {
        "label": "Process Success",
        "description": "Procesar datos válidos",
        "actionConfig": {
          "actionType": "success_processing",
          "parameters": {
            "transformType": "uppercase",
            "addTimestamp": true
          }
        }
      }
    },
    {
      "id": "action-false",
      "type": "ACTION",
      "position": { "x": 400, "y": 250 },
      "data": {
        "label": "Process Error",
        "description": "Procesar datos inválidos",
        "actionConfig": {
          "actionType": "error_processing",
          "parameters": {
            "logError": true,
            "sendNotification": true
          }
        }
      }
    },
    {
      "id": "end-1",
      "type": "END",
      "position": { "x": 600, "y": 200 },
      "data": {
        "label": "End",
        "description": "Nodo final"
      }
    }
  ],
  "edges": [
    {
      "id": "edge-1",
      "source": "start-1",
      "target": "condition-1",
      "sourceHandle": "start-output",
      "targetHandle": "condition-input",
      "dataFlow": {
        "fieldMappings": [
          {
            "sourceField": "data",
            "targetField": "data",
            "required": true,
            "description": "Mapear datos completos"
          }
        ],
        "transformations": [
          {
            "id": "trans-1",
            "type": "TRANSFORM",
            "field": "status",
            "expression": "toUpperCase",
            "order": 1,
            "description": "Convertir estado a mayúsculas",
            "enabled": true
          }
        ],
        "validation": {
          "isValid": true,
          "errors": [],
          "warnings": []
        }
      }
    },
